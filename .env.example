# --- Entorno ---
APP_ENV=development            # development | production (production activa HTTPS, cookies Secure y HSTS)
APP_URL=http://localhost:8000  # URL pública; en producción: https://respira.pierooof.dev
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
PORT=8000
TRUSTED_PROXIES=1              # nº de proxies delante de la app (Cloudflare + Railway suele ser 2)

# --- Base de datos MySQL 8 (usa MYSQL_URL o el grupo MYSQLHOST/...; Railway los inyecta) ---
MYSQL_URL=mysql://respira:respira@127.0.0.1:3306/respira
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# --- Telegram (opcional: sin token el bot y los avisos quedan desactivados) ---
TELEGRAM_TOKEN=
# Usuario del bot sin @, para generar el enlace t.me en la web
TELEGRAM_BOT_USERNAME=

# --- Open-Meteo / worker ---
CACHE_TTL_SECONDS=3600         # vida de la caché de la API
REFRESH_MINUTES=60             # cada cuánto refresca el worker
ALERT_HOUR=19                  # hora (Madrid) a la que el worker envía los avisos de "mañana"
